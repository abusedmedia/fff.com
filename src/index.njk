<script>
function openHowItWorksAdvisoryModal() {
  document.getElementById('how-it-works-modal').style.display = 'flex';
  document.body.style.overflow = 'hidden';
}

function openHowItWorksPartnershipModal() {
  document.getElementById('how-it-works-partnership-modal').style.display = 'flex';
  document.body.style.overflow = 'hidden';
}

function closeHowItWorksModal() {
  document.getElementById('how-it-works-modal').style.display = 'none';
  document.body.style.overflow = 'auto';
}

function closeHowItWorksPartnershipModal() {
  document.getElementById('how-it-works-partnership-modal').style.display = 'none';
  document.body.style.overflow = 'auto';
}

function openPartnershipModal() {
  document.getElementById('partnership-modal').style.display = 'flex';
  document.body.style.overflow = 'hidden';
}

function closePartnershipModal() {
  document.getElementById('partnership-modal').style.display = 'none';
  document.body.style.overflow = 'auto';
  document.getElementById('partnership-form').reset();
  // Reset price buttons
  document.querySelectorAll('.price-btn').forEach(btn => {
    btn.classList.remove('bg-cyan-500', 'text-white', 'border-cyan-400');
    btn.classList.add('border-gray-300', 'text-black');
  });
}

function selectPrice(button, value) {
  document.querySelectorAll('.price-btn').forEach(btn => {
    btn.classList.remove('bg-cyan-500', 'text-white', 'border-cyan-400');
    btn.classList.add('border-gray-300', 'text-black');
  });
  
  button.classList.remove('border-gray-300', 'text-black');
  button.classList.add('bg-cyan-500', 'text-white', 'border-cyan-400');
  
  // Set hidden input value (in thousands)
  document.getElementById('partnership-price').value = value * 1000;
}

function submitPartnershipForm(event) {
  event.preventDefault();
  
  const email = document.getElementById('partnership-email').value;
  const price = document.getElementById('partnership-price').value;
  const comment = document.getElementById('partnership-comment').value;
  const submitBtn = document.getElementById('partnership-submit-btn');
  
  // Validate that a price was selected
  if (!price) {
    alert('Please select a suggested price.');
    return;
  }
  
  // Disable button and show loading state
  submitBtn.disabled = true;
  submitBtn.textContent = 'Sending...';
  
  // TODO: Add your service call here
  // You now have access to email, price, and comment values
  console.log('Email:', email);
  console.log('Suggested Price:', price, '€/month');
  console.log('Comment:', comment);
  
  // For now, we'll simulate a successful submission
  setTimeout(() => {
    alert('Thank you for your interest! I\'ll be in touch soon.');
    closePartnershipModal();
    
    // Reset button
    submitBtn.disabled = false;
    submitBtn.textContent = 'Send';
  }, 1500);
}

// Close modal when clicking outside
document.getElementById('partnership-modal').addEventListener('click', function(e) {
  if (e.target === this) {
    closePartnershipModal();
  }
});

// Close modal with Escape key
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    const howItWorksModal = document.getElementById('how-it-works-modal');
    const howItWorksPartnershipModal = document.getElementById('how-it-works-partnership-modal');
    const partnershipModal = document.getElementById('partnership-modal');
    
    if (howItWorksModal && howItWorksModal.style.display === 'flex') {
      closeHowItWorksModal();
    }
    if (howItWorksPartnershipModal && howItWorksPartnershipModal.style.display === 'flex') {
      closeHowItWorksPartnershipModal();
    }
    if (partnershipModal && partnershipModal.style.display === 'flex') {
      closePartnershipModal();
    }
  }
});

// Close how-it-works modal when clicking outside
document.getElementById('how-it-works-modal').addEventListener('click', function(e) {
  if (e.target === this) {
    closeHowItWorksModal();
  }
});

// Close partnership how-it-works modal when clicking outside
document.getElementById('how-it-works-partnership-modal').addEventListener('click', function(e) {
  if (e.target === this) {
    closeHowItWorksPartnershipModal();
  }
});
</script>

