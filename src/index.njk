{# Partnership Modal #}
<div id="partnership-modal" class="fixed inset-0 bg-black bg-opacity-75 flex items-center justify-center z-50 p-4" style="display: none;">
  <div class="bg-white text-black p-8 md:p-8 max-w-md w-full mx-4 rounded-lg max-h-[90vh] overflow-y-auto">
    <div class="flex justify-between items-center mb-4 md:mb-6">
      <h3 class="text-xl md:text-2xl font-black uppercase">Interested?</h3>
      <button onclick="closePartnershipModal()" class="text-gray-500 hover:text-black text-xl md:text-2xl font-bold">
        ×
      </button>
    </div>
    
    <p class="text-sm md:text-base text-gray-600 mb-4 md:mb-6">
      I'll reply to you with a personal message giving more details about the Partnership tier, and when it'll be available.
    </p>
    
    <form id="partnership-form" onsubmit="submitPartnershipForm(event)">
      <div class="mb-4 md:mb-6">
        
        <input
          type="email"
          id="partnership-email"
          name="email"
          required
          class="w-full px-3 md:px-4 py-2 md:py-3 border-2 border-gray-300 focus:border-cyan-400 focus:outline-none text-black text-sm md:text-base"
          placeholder="your@email.com"
        >
      </div>
      
      <div class="mb-4 md:mb-6">
        <label class="block text-sm font-bold mb-3">What is a fair price?</label>
        <div class="flex items-center gap-3">
          <div class="flex gap-2 flex-1">
            <button
              type="button"
              onclick="selectPrice(this, 1)"
              class="price-btn flex-1 aspect-square border-2 border-gray-300 hover:border-cyan-400 text-black font-bold text-lg transition-all duration-200"
            >
              1
            </button>
            <button
              type="button"
              onclick="selectPrice(this, 2)"
              class="price-btn flex-1 aspect-square border-2 border-gray-300 hover:border-cyan-400 text-black font-bold text-lg transition-all duration-200"
            >
              2
            </button>
            <button
              type="button"
              onclick="selectPrice(this, 3)"
              class="price-btn flex-1 aspect-square border-2 border-gray-300 hover:border-cyan-400 text-black font-bold text-lg transition-all duration-200"
            >
              3
            </button>
            <button
              type="button"
              onclick="selectPrice(this, 4)"
              class="price-btn flex-1 aspect-square border-2 border-gray-300 hover:border-cyan-400 text-black font-bold text-lg transition-all duration-200"
            >
              4
            </button>
            <button
              type="button"
              onclick="selectPrice(this, 5)"
              class="price-btn flex-1 aspect-square border-2 border-gray-300 hover:border-cyan-400 text-black font-bold text-lg transition-all duration-200"
            >
              5
            </button>
            <button
              type="button"
              onclick="selectPrice(this, 6)"
              class="price-btn flex-1 aspect-square border-2 border-gray-300 hover:border-cyan-400 text-black font-bold text-lg transition-all duration-200"
            >
              6
            </button>
            <button
              type="button"
              onclick="selectPrice(this, 7)"
              class="price-btn flex-1 aspect-square border-2 border-gray-300 hover:border-cyan-400 text-black font-bold text-lg transition-all duration-200"
            >
              7
            </button>
            <button
              type="button"
              onclick="selectPrice(this, 8)"
              class="price-btn flex-1 aspect-square border-2 border-gray-300 hover:border-cyan-400 text-black font-bold text-lg transition-all duration-200"
            >
              8
            </button>
            <button
              type="button"
              onclick="selectPrice(this, 9)"
              class="price-btn flex-1 aspect-square border-2 border-gray-300 hover:border-cyan-400 text-black font-bold text-lg transition-all duration-200"
            >
              9
            </button>
          </div>
          <div class="text-2xl font-bold text-gray-700">k€</div>
        </div>
        <input
